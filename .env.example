# ====================================================
# Coffee & Bagels Production Environment Configuration
# ====================================================

NODE_ENV=production
PORT=8080
JWT_SECRET=your_production_super_secret_jwt_key_here

# ----------------------------------------------------
# 1. Cloud Database Connection (Turso / Supabase / PostgreSQL)
# ----------------------------------------------------
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# ----------------------------------------------------
# 2. Real SMS Gateway API (Fast2SMS / Twilio)
# ----------------------------------------------------
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------------
# 3. Real Email Gateway API (Resend / SMTP)
# ----------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key_here
